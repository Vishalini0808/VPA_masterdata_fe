<mvc:View
    controllerName="vpamasterdata.controller.RTOMasters"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="rtoMastersPage"
        title="RTO Master"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <!-- ===================================================== -->
            <!-- FILTER AREA -->
            <!-- ===================================================== -->

            <VBox class="sapUiSmallMargin">

                <HBox
                    justifyContent="SpaceBetween"
                    width="100%">

                    <!-- REGION -->
                    <VBox width="30%">

                        <Label text="Region"/>

                        <ComboBox
                            id="regionFilter"
                            width="100%"
                            placeholder="Select Region"
                            items="{path: '/Regions'}">

                            <core:Item
                                key="{regionCode}"
                                text="{regionCode}"/>

                        </ComboBox>

                    </VBox>

                    <!-- ENGINE TYPE -->
                    <VBox width="30%">

                        <Label text="Engine Type"/>

                        <ComboBox
                            id="engineTypeFilter"
                            width="100%"
                            placeholder="Select Engine Type">

                            <core:Item key="Petrol" text="Petrol"/>
                            <core:Item key="EV" text="EV"/>

                        </ComboBox>

                    </VBox>

                    <!-- APPROVAL STATUS -->
                    <VBox width="30%">

                        <Label text="Approval Status"/>

                        <ComboBox
                            id="approvalStatusFilter"
                            width="100%"
                            placeholder="Select Approval Status">

                            <core:Item key="DRAFT" text="DRAFT"/>
                            <core:Item key="SUBMITTED" text="SUBMITTED"/>
                            <core:Item key="APPROVED" text="APPROVED"/>
                            <core:Item key="REJECTED" text="REJECTED"/>

                        </ComboBox>

                    </VBox>

                </HBox>

                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginTop">

                    <Button
                        text="Go"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press=".onFilter"/>

                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        type="Transparent"
                        class="sapUiTinyMarginBegin"
                        press=".onClearFilters"/>

                    <Button
                        text="Adapt Filters"
                        type="Transparent"
                        class="sapUiTinyMarginBegin"
                        press=".onAdaptFilters"/>

                </HBox>

            </VBox>

            <!-- ===================================================== -->
            <!-- RTO MASTER TABLE -->
            <!-- ===================================================== -->

            <Table
                id="rtoMastersTable"
                items="{path: '/RTOMasters'}"
                growing="true"
                growingThreshold="20"
                sticky="ColumnHeaders">

                <headerToolbar>
                    <OverflowToolbar>

                        <Title
                            text="RTO Masters"
                            level="H2"/>

                        <ToolbarSpacer/>

                        <Button
                            text="Create"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onAdd"/>

                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column><Text text="Region"/></Column>
                    <Column><Text text="Valid From"/></Column>
                    <Column><Text text="Slab"/></Column>
                    <Column><Text text="Engine Type"/></Column>
                    <Column><Text text="CC Min"/></Column>
                    <Column><Text text="CC Max"/></Column>
                    <Column><Text text="Minimum Price"/></Column>
                    <Column><Text text="Maximum Price"/></Column>
                    <Column><Text text="RTO %"/></Column>
                    <Column><Text text="Flat Price"/></Column>
                    <Column><Text text="Approval Status"/></Column>
                    <Column width="8rem"><Text text="Actions"/></Column>
                </columns>

                <items>

                    <ColumnListItem>

                        <cells>

                            <Text text="{region_regionCode}"/>
                            <Text text="{validFrom}"/>
                            <Text text="{slab}"/>
                            <Text text="{engineType}"/>
                            <Text text="{ccMin}"/>
                            <Text text="{ccMax}"/>
                            <Text text="{minimumPrice}"/>
                            <Text text="{maximumPrice}"/>
                            <Text text="{rtoPercent}"/>
                            <Text text="{flatPriceValue}"/>

                            <!-- APPROVAL STATUS: APPROVED green, SUBMITTED orange, REJECTED red, others grey -->
                            <ObjectStatus
                                text="{approvalStatus}"
                                state="{= ${approvalStatus} === 'APPROVED' ? 'Success' : ${approvalStatus} === 'SUBMITTED' ? 'Warning' : ${approvalStatus} === 'REJECTED' ? 'Error' : 'None'}"/>

                            <HBox>

                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit"
                                    press=".onEdit"/>

                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Delete"
                                    press=".onDelete"/>

                            </HBox>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </content>

    </Page>

</mvc:View>