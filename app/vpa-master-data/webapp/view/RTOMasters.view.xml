<mvc:View

    controllerName="vpamasterdata.controller.RTOMasters"

    xmlns:mvc="sap.ui.core.mvc"

    xmlns="sap.m"

    xmlns:core="sap.ui.core">
 
    <Page

        id="rtoMastersPage"

        class="vpaPage"

        backgroundDesign="Transparent"

        enableScrolling="true">
 
        <customHeader>
<Bar class="vpaHeader">
<contentLeft>
<Button

                        icon="sap-icon://nav-back"

                        type="Transparent"

                        tooltip="Back"

                        press=".onNavBack"/>
<Title text="RTO Master" level="H1"/>
</contentLeft>
</Bar>
</customHeader>
 
        <content>
 
            <!-- ================= FILTERS ================= -->
<Panel

                class="vpaCard sapUiSmallMargin"

                headerText="Filters"

                expandable="true"

                expanded="true"

                backgroundDesign="Solid">
 
                <HBox

                    alignItems="End"

                    wrap="Wrap"

                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
 
                    <VBox id="regionFilterBox" class="sapUiMediumMarginEnd">
<Label text="Region" design="Bold"/>
<ComboBox

                            id="regionFilter"

                            width="16rem"

                            placeholder="Select Region"

                            items="{path: '/Regions'}">
<core:Item key="{regionCode}" text="{regionCode}"/>
</ComboBox>
</VBox>
 
                    <VBox id="engineTypeFilterBox" class="sapUiMediumMarginEnd">
<Label text="Engine Type" design="Bold"/>
<ComboBox

                            id="engineTypeFilter"

                            width="12rem"

                            placeholder="Select Engine Type">
<core:Item key="Petrol" text="Petrol"/>
<core:Item key="EV" text="EV"/>
</ComboBox>
</VBox>
 
                    <VBox id="approvalStatusFilterBox" class="sapUiMediumMarginEnd">
<Label text="Approval Status" design="Bold"/>
<ComboBox

                            id="approvalStatusFilter"

                            width="12rem"

                            placeholder="Select Status">
<core:Item key="DRAFT" text="DRAFT"/>
<core:Item key="SUBMITTED" text="SUBMITTED"/>
<core:Item key="APPROVED" text="APPROVED"/>
<core:Item key="REJECTED" text="REJECTED"/>
</ComboBox>
</VBox>
 
                    <Button

                        text="Search"

                        icon="sap-icon://search"

                        type="Emphasized"

                        press=".onFilter"/>
<Button

                        text="Clear"

                        icon="sap-icon://clear-filter"

                        class="sapUiTinyMarginBegin"

                        press=".onClearFilters"/>
<Button

                        text="Adapt Filters"

                        type="Transparent"

                        class="sapUiTinyMarginBegin"

                        press=".onAdaptFilters"/>
</HBox>
</Panel>
 
            <!-- ================= TABLE ================= -->
<VBox class="vpaCard vpaTableCard sapUiSmallMargin">
 
                <!-- title bar: outside the scroll container, so it does not scroll -->
<OverflowToolbar>
<Title

                        text="{= 'RTO Masters (' + ${viewModel>/count} + ')' }"

                        level="H2"/>
<ToolbarSpacer/>
<Button

                        text="Add Row"

                        icon="sap-icon://add"

                        type="Emphasized"

                        press=".onAddRow"/>
<Button

                        text="Refresh"

                        icon="sap-icon://refresh"

                        type="Transparent"

                        press=".onRefresh"/>
</OverflowToolbar>
 
                <ScrollContainer

                    width="100%"

                    horizontal="true"

                    vertical="false">
 
                    <Table

                        id="rtoMastersTable"

                        class="vpaTable"

                        items="{

                            path: '/RTOMasters',

                            parameters: { $$updateGroupId: 'rtoGroup', $count: true },

                            sorter: { path: 'region_regionCode' }

                        }"

                        growing="true"

                        growingThreshold="20"

                        mode="MultiSelect"

                        updateFinished=".onTableUpdateFinished">
 
                        <columns>
<Column width="9rem"  hAlign="Begin"  vAlign="Middle"><Text text="Region"/></Column>
<Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Valid From"/></Column>
<Column width="6rem"  hAlign="End"    vAlign="Middle"><Text text="Slab"/></Column>
<Column width="9rem"  hAlign="Begin"  vAlign="Middle"><Text text="Engine Type"/></Column>
<Column width="7rem"  hAlign="End"    vAlign="Middle"><Text text="CC Min"/></Column>
<Column width="7rem"  hAlign="End"    vAlign="Middle"><Text text="CC Max"/></Column>
<Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="Minimum Price"/></Column>
<Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="Maximum Price"/></Column>
<Column width="7rem"  hAlign="End"    vAlign="Middle"><Text text="RTO %"/></Column>
<Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="Flat Price"/></Column>
<Column width="10rem" hAlign="Center" vAlign="Middle"><Text text="Approval Status"/></Column>
<Column width="7rem"  hAlign="Center" vAlign="Middle"><Text text="Actions"/></Column>
</columns>
 
                        <!-- cells 1 and 3..9 are VBox [Text, editor]; the text shows in display mode,

                             the editor in edit mode (new rows are always in edit mode) -->
<items>
<ColumnListItem vAlign="Middle">
<cells>
 
                                    <!-- 0 REGION (key: editable only on new rows) -->
<VBox>
<Text

                                            text="{region_regionCode}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{region_regionCode}"

                                            placeholder="Region code"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 1 VALID FROM -->
<VBox>
<Text

                                            text="{validFrom}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<DatePicker

                                            value="{validFrom}"

                                            width="100%"

                                            valueFormat="yyyy-MM-dd"

                                            displayFormat="dd-MM-yyyy"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 2 SLAB (key: editable only on new rows) -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{slab}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{slab}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 3 ENGINE TYPE -->
<VBox>
<Text

                                            text="{engineType}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Select

                                            selectedKey="{engineType}"

                                            width="100%"

                                            visible="{= !!%{@$ui5.context.isTransient} }">
<core:Item key="Petrol" text="Petrol"/>
<core:Item key="EV" text="EV"/>
</Select>
</VBox>
 
                                    <!-- 4 CC MIN -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{ccMin}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{ccMin}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 5 CC MAX -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{ccMax}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{ccMax}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 6 MINIMUM PRICE -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{minimumPrice}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{minimumPrice}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 7 MAXIMUM PRICE -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{maximumPrice}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{maximumPrice}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 8 RTO % -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{rtoPercent}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{rtoPercent}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 9 FLAT PRICE -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{flatPriceValue}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{flatPriceValue}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 10 APPROVAL STATUS (set by the system) -->
<ObjectStatus

                                        text="{approvalStatus}"

                                        state="{= ${approvalStatus} === 'DRAFT' ? 'Warning' : ${approvalStatus} === 'REJECTED' ? 'Error' : ${approvalStatus} === 'APPROVED' ? 'Success' : 'Information' }"/>
 
                                    <!-- 11 ACTIONS (edit only makes sense on saved rows) -->
<HBox justifyContent="Center">
<Button

                                            icon="sap-icon://edit"

                                            type="Transparent"

                                            tooltip="Edit"

                                            press=".onEdit"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Button

                                            icon="sap-icon://delete"

                                            type="Transparent"

                                            tooltip="Delete"

                                            press=".onDelete"/>
</HBox>
 
                                </cells>
</ColumnListItem>
</items>
</Table>
 
                </ScrollContainer>
</VBox>
</content>
 
        <footer>
<OverflowToolbar>
<ToolbarSpacer/>
<Button

                    text="Cancel"

                    type="Transparent"

                    press=".onCancel"/>
<Button

                    text="Submit"

                    type="Emphasized"

                    press=".onSubmit"/>
</OverflowToolbar>
</footer>
 
    </Page>
 
</mvc:View>
 