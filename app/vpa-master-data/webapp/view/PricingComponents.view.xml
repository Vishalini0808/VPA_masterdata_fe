<mvc:View
    controllerName="vpamasterdata.controller.PricingComponents"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="Pricing Components"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <!-- ================================================= -->
            <!-- FILTER AREA -->
            <!-- ================================================= -->

            <VBox>

                <HBox
                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd sapUiSmallMarginTop"
                    justifyContent="SpaceBetween">

                    <!-- Region Code -->

                    <VBox width="31%">

                        <Label text="Region Code"/>

                        <Select
                            id="regionCodeFilterPC"
                            width="100%"
                            forceSelection="false"
                            items="{/Regions}">

                            <core:Item
                                key="{regionCode}"
                                text="{regionCode}"/>

                        </Select>

                    </VBox>


                    <!-- Engine Type -->

                    <VBox width="31%">

                        <Label text="Engine Type"/>

                        <Select
                            id="engineTypeFilterPC"
                            width="100%"
                            forceSelection="false"
                            >

                            <core:Item
                                key="Petrol"
                                text="Petrol"/>

                            <core:Item
                                key="EV"
                                text="EV"/>

                        </Select>

                    </VBox>


                    <!-- Approval Status -->

                    <VBox width="31%">

                        <Label text="Approval Status"/>

                        <Select
                            id="approvalStatusFilterPC"
                            width="100%"
                            forceSelection="false"
                            >

                            <core:Item
                                key="DRAFT"
                                text="DRAFT"/>

                            <core:Item
                                key="SUBMITTED"
                                text="SUBMITTED"/>

                            <core:Item
                                key="APPROVED"
                                text="APPROVED"/>

                            <core:Item
                                key="REJECTED"
                                text="REJECTED"/>

                        </Select>

                    </VBox>

                </HBox>


                <!-- ================================================= -->
                <!-- FILTER BUTTONS -->
                <!-- ================================================= -->

                <HBox
                    justifyContent="End"
                    class="sapUiSmallMarginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">

                    <Button
                        text="Go"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press=".onGoFilter"/>

                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        type="Transparent"
                        class="sapUiTinyMarginBegin"
                        press=".onClearFilter"/>

                    <Button
                        text="Adapt Filters"
                        type="Transparent"
                        class="sapUiTinyMarginBegin"
                        press=".onAdaptFilters"/>

                </HBox>

            </VBox>


            <!-- ================================================= -->
            <!-- PRICING COMPONENTS TABLE -->
            <!-- ================================================= -->

            <Table
                id="pricingComponentsTable"
                items="{/PricingComponents}"
                growing="true"
                growingThreshold="20"
                mode="MultiSelect"
                includeItemInSelection="true">

                <headerToolbar>

                    <Toolbar>

                        <Title
                            text="Pricing Components"
                            level="H2"/>

                        <ToolbarSpacer/>

                        <Button
                            text="Create"
                            icon="sap-icon://add"
                            type="Emphasized"
                            press=".onAdd"/>

                    </Toolbar>

                </headerToolbar>


                <!-- ================================================= -->
                <!-- COLUMNS -->
                <!-- ================================================= -->

                <columns>

                    <Column>
                        <Text text="Region Code"/>
                    </Column>

                    <Column>
                        <Text text="Engine Type"/>
                    </Column>

                    <Column>
                        <Text text="Valid From"/>
                    </Column>

                    <Column>
                        <Text text="Helmet"/>
                    </Column>

                    <Column>
                        <Text text="Transportation"/>
                    </Column>

                    <Column>
                        <Text text="Helmet Margin"/>
                    </Column>

                    <Column>
                        <Text text="Other Expenses &lt; 500"/>
                    </Column>

                    <Column>
                        <Text text="Other Expenses &gt; 500"/>
                    </Column>

                    <Column>
                        <Text text="Insurance &lt; 350"/>
                    </Column>

                    <Column>
                        <Text text="Insurance &gt; 350"/>
                    </Column>

                    <Column>
                        <Text text="TPA/PA &lt; 350"/>
                    </Column>

                    <Column>
                        <Text text="TPA/PA &gt; 350"/>
                    </Column>

                    <Column>
                        <Text text="No Plate Charges"/>
                    </Column>

                    <Column>
                        <Text text="Approval Status"/>
                    </Column>

                    <Column
                        width="8rem"
                        hAlign="Center">

                        <Text text="Actions"/>

                    </Column>

                </columns>


                <!-- ================================================= -->
                <!-- ROWS -->
                <!-- ================================================= -->

                <items>

                    <ColumnListItem>

                        <cells>

                            <Text text="{regionCode}"/>

                            <Text text="{engineType}"/>

                            <Text text="{validFrom}"/>

                            <Text text="{helmet}"/>

                            <Text text="{transportation}"/>

                            <Text text="{helmetMargin}"/>

                            <Text text="{otherExpensesBelow500}"/>

                            <Text text="{otherExpensesAbove500}"/>

                            <Text text="{insuranceRateBelow350}"/>

                            <Text text="{insuranceRateAbove350}"/>

                            <Text text="{tpaPaBelow350}"/>

                            <Text text="{tpaPaAbove350}"/>

                            <Text text="{noPlateCharges}"/>

                            <ObjectStatus
                                text="{approvalStatus}"/>


                            <!-- Actions -->

                            <HBox
                                justifyContent="Center">

                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit"
                                    press=".onEdit"/>

                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Delete"
                                    press=".onDelete"/>

                                <Button
                                    icon="sap-icon://navigation-right-arrow"
                                    type="Transparent"
                                    tooltip="View Details"
                                    press=".onView"/>

                            </HBox>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </content>

    </Page>

</mvc:View>