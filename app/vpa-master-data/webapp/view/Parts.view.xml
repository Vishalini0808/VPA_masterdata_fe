
<mvc:View
    controllerName="vpamasterdata.controller.Parts"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="Parts"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <!-- =====================================================
                 FILTER AREA
                 ===================================================== -->

            <VBox
                class="sapUiMediumMarginBottom">

                <HBox
                    width="100%"
                    alignItems="End"
                    class="sapUiSmallMarginBegin sapUiSmallMarginEnd">

                    <!-- =================================================
                         PART CODE
                         ================================================= -->

                    <VBox
                            width="25%"
                            class="sapUiSmallMarginEnd sapUiSmallMarginTop">

                            <Label
                                text="Part Code" />

                            <ComboBox
                                id="partCodeFilter"
                                width="100%"
                                placeholder="Select Part Code"
                                items="{/Parts}">

                                <core:Item
                                    key="{partCode}"
                                    text="{partCode}" />

                            </ComboBox>

                    </VBox>


                    <!-- =================================================
                         PART DESCRIPTION
                         ================================================= -->

                  <VBox
                        width="30%"
                        class="sapUiSmallMarginEnd sapUiSmallMarginTop">

                        <Label
                            text="Part Description" />

                        <ComboBox
                            id="partDescriptionFilter"
                            width="100%"
                            placeholder="Select Part Description"
                            items="{/Parts}">

                            <core:Item
                                key="{description}"
                                text="{description}" />

                        </ComboBox>

                    </VBox>

                    <!-- =================================================
                         FILTER BUTTONS
                         ================================================= -->

                    <HBox>

                        <Button
                            text="Go"
                            type="Emphasized"
                            icon="sap-icon://search"
                            press=".onGoFilter"
                            class="sapUiTinyMarginEnd" />

                        <Button
                            text="Clear"
                            icon="sap-icon://clear-filter"
                            press=".onClearFilter" />

                    </HBox>

                </HBox>

            </VBox>


            <!-- =====================================================
                 PARTS SECTION TOOLBAR
                 ===================================================== -->

            <Toolbar
                class="sapUiSmallMarginBegin sapUiSmallMarginEnd">

                <Title
                    text="Parts"
                    level="H2" />

                <ToolbarSpacer />

                <Button
                    text="Create"
                    icon="sap-icon://add"
                    type="Emphasized"
                    press=".onAdd" />

            </Toolbar>


            <!-- =====================================================
                 PARTS TABLE
                 ===================================================== -->

            <Table
                id="partsTable"
                items="{/Parts}"
                growing="true"
                growingThreshold="20">

                <!-- =================================================
                     TABLE COLUMNS
                     ================================================= -->

                <columns>

                    <!-- Part Code -->

                    <Column>

                        <Text
                            text="Part Code" />

                    </Column>


                    <!-- Valid From -->

                    <Column>

                        <Text
                            text="Valid From" />

                    </Column>


                    <!-- Description -->

                    <Column>

                        <Text
                            text="Description" />

                    </Column>


                    <!-- MIY Cost -->

                    <Column>

                        <Text
                            text="MIY Cost" />

                    </Column>


                    <!-- MIY Markup -->

                    <Column>

                        <Text
                            text="MIY Markup" />

                    </Column>


                    <!-- Price Indicator -->

                    <Column>

                        <Text
                            text="Price Indicator" />

                    </Column>


                    <!-- Actions -->

                    <Column
                        width="8rem"
                        hAlign="Center">

                        <Text
                            text="Actions" />

                    </Column>

                </columns>


                <!-- =================================================
                     TABLE ITEMS
                     ================================================= -->

                <items>

                    <ColumnListItem>

                        <cells>

                            <!-- Part Code -->

                            <Text
                                text="{partCode}" />


                            <!-- Valid From -->

                            <Text
                                text="{validFrom}" />


                            <!-- Description -->

                            <Text
                                text="{description}" />


                            <!-- MIY Cost -->

                            <Text
                                text="{miyCost}" />


                            <!-- MIY Markup -->

                            <Text
                                text="{miyMarkup}" />


                            <!-- Price Indicator -->

                            <Text
                                text="{priceIndicator}" />


                            <!-- Actions -->

                            <HBox
                                justifyContent="Center">

                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit"
                                    press=".onEdit" />

                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    tooltip="Delete"
                                    press=".onDelete" />

                            </HBox>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </content>

    </Page>

</mvc:View>