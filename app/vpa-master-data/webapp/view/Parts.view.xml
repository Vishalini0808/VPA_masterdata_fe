<mvc:View

    controllerName="vpamasterdata.controller.Parts"

    xmlns:mvc="sap.ui.core.mvc"

    xmlns="sap.m"

    xmlns:core="sap.ui.core">
 
    <Page

        id="partsPage"

        class="vpaPage"

        backgroundDesign="Transparent"

        enableScrolling="true">
 
        <customHeader>
<Bar class="vpaHeader">
<contentLeft>
<Button

                        icon="sap-icon://nav-back"

                        type="Transparent"

                        tooltip="Back"

                        press=".onNavBack"/>
<Title text="Parts" level="H1"/>
</contentLeft>
</Bar>
</customHeader>
 
        <content>
 
            <!-- ================= FILTERS ================= -->
<Panel

                class="vpaCard sapUiSmallMargin"

                headerText="Filters"

                expandable="true"

                expanded="true"

                backgroundDesign="Solid">
 
                <HBox

                    alignItems="End"

                    wrap="Wrap"

                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
 
                    <VBox class="sapUiMediumMarginEnd">
<Label text="Part Code" design="Bold"/>
<ComboBox

                            id="partCodeFilter"

                            width="16rem"

                            placeholder="Select Part Code"

                            items="{filter>/partCodes}">
<core:Item key="{filter>key}" text="{filter>text}"/>
</ComboBox>
</VBox>
 
                    <VBox class="sapUiMediumMarginEnd">
<Label text="Part Description" design="Bold"/>
<ComboBox

                            id="partDescriptionFilter"

                            width="20rem"

                            placeholder="Select Part Description"

                            items="{filter>/descriptions}">
<core:Item key="{filter>key}" text="{filter>text}"/>
</ComboBox>
</VBox>
 
                    <Button

                        text="Search"

                        icon="sap-icon://search"

                        type="Emphasized"

                        press=".onGoFilter"/>
<Button

                        text="Clear"

                        icon="sap-icon://clear-filter"

                        class="sapUiTinyMarginBegin"

                        press=".onClearFilter"/>
</HBox>
</Panel>
 
            <!-- ================= TABLE ================= -->
<VBox class="vpaCard vpaTableCard sapUiSmallMargin">
 
                <!-- title bar: outside the scroll container, so it does not scroll -->
<OverflowToolbar>
<Title

                        text="{= 'Parts (' + ${viewModel>/count} + ')' }"

                        level="H2"/>
<ToolbarSpacer/>
<Button

                        text="Add Row"

                        icon="sap-icon://add"

                        type="Emphasized"

                        press=".onAddRow"/>
<Button

                        text="Refresh"

                        icon="sap-icon://refresh"

                        type="Transparent"

                        press=".onRefresh"/>
</OverflowToolbar>
 
                <ScrollContainer

                    width="100%"

                    horizontal="true"

                    vertical="false">
 
                    <Table

                        id="partsTable"

                        class="vpaTable"

                        items="{

                            path: '/Parts',

                            parameters: { $$updateGroupId: 'partGroup', $count: true },

                            sorter: { path: 'partCode' }

                        }"

                        growing="true"

                        growingThreshold="20"

                        mode="MultiSelect"

                        updateFinished=".onTableUpdateFinished">
 
                        <columns>
<Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Part Code"/></Column>
<Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Valid From"/></Column>
<Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Description"/></Column>
<Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="MIY Cost"/></Column>
<Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="MIY Markup"/></Column>
<Column width="9rem"  hAlign="Begin"  vAlign="Middle"><Text text="Price Indicator"/></Column>
<Column width="9rem"  hAlign="Begin" vAlign="Middle"><Text text="Status"/></Column>
<Column width="7rem"  hAlign="Center" vAlign="Middle"><Text text="Actions"/></Column>
</columns>
 
                        <!-- cells 1..5 are VBox [Text, editor]; the text shows in display mode,

                             the editor in edit mode (new rows are always in edit mode) -->
<items>
<ColumnListItem vAlign="Middle">
<cells>
 
                                    <!-- 0 PART CODE (key: editable only on new rows) -->
<VBox>
<Text

                                            text="{partCode}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{partCode}"

                                            placeholder="Part code"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 1 VALID FROM -->
<VBox>
<Text

                                            text="{validFrom}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<DatePicker

                                            value="{validFrom}"

                                            width="100%"

                                            valueFormat="yyyy-MM-dd"

                                            displayFormat="dd-MM-yyyy"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 2 DESCRIPTION -->
<VBox>
<Text

                                            text="{description}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{description}"

                                            placeholder="Description"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>



 
                                    <!-- 4 MIY COST -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{miyCost}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{miyCost}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 5 MIY MARKUP -->
<VBox>
<Text

                                            width="100%"

                                            textAlign="End"

                                            text="{miyMarkup}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{miyMarkup}"

                                            type="Number"

                                            textAlign="End"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>
 
                                    <!-- 6 PRICE INDICATOR -->
<VBox>
<Text

                                            text="{priceIndicator}"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<Input

                                            value="{priceIndicator}"

                                            placeholder="Indicator"

                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
</VBox>

<!-- 3 APPROVAL STATUS (read-only) -->
<ObjectStatus
    text="{approvalStatus}"
    state="{= ${approvalStatus} === 'APPROVED' ? 'Success'
            : ${approvalStatus} === 'SUBMITTED' ? 'Warning'
            : ${approvalStatus} === 'REJECTED' ? 'Error'
            : 'None' }"/>
 
                                    <!-- 7 ACTIONS (edit only makes sense on saved rows) -->
<HBox justifyContent="Center">
<Button

                                            icon="sap-icon://edit"

                                            type="Transparent"

                                            tooltip="Edit"

                                            press=".onEdit"

                                            visible="{= !%{@$ui5.context.isTransient} }"/>
<!-- <Button

                                            icon="sap-icon://delete"

                                            type="Transparent"

                                            tooltip="Delete"

                                            press=".onDelete"/> -->
</HBox>
 
                                </cells>
</ColumnListItem>
</items>
</Table>
 
                </ScrollContainer>
</VBox>
</content>
 
        <footer>
<OverflowToolbar>
<ToolbarSpacer/>
<Button

                    text="Cancel"

                    type="Transparent"

                    press=".onCancel"/>
<Button

                    text="Submit"

                    type="Emphasized"

                    press=".onSubmit"/>
</OverflowToolbar>
</footer>
 
    </Page>
 
</mvc:View>
 