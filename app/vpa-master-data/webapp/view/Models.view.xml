<mvc:View
    controllerName="vpamasterdata.controller.Models"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="modelPage"
        class="vpaPage"
        backgroundDesign="Transparent"
        enableScrolling="true">

        <customHeader>
            <Bar class="vpaHeader">
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back"
                        press=".onNavBack"/>
                    <Title text="Model Master" level="H1"/>
                </contentLeft>
            </Bar>
        </customHeader>

        <content>

            <!-- ================= FILTERS ================= -->
            <Panel
                class="vpaCard sapUiSmallMargin"
                headerText="Filters"
                expandable="true"
                expanded="true"
                backgroundDesign="Solid">

                <HBox
                    alignItems="End"
                    wrap="Wrap"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Model Code" design="Bold"/>
                        <ComboBox
                            id="modelCodeFilter"
                            width="16rem"
                            placeholder="Select Model Code"
                            items="{filter>/modelCodes}">
                            <core:Item key="{filter>key}" text="{filter>text}"/>
                        </ComboBox>
                    </VBox>

                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Model Description" design="Bold"/>
                        <ComboBox
                            id="modelDescriptionFilter"
                            width="16rem"
                            placeholder="Select Model Description"
                            items="{filter>/descriptions}">
                            <core:Item key="{filter>key}" text="{filter>text}"/>
                        </ComboBox>
                    </VBox>

                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Order Type" design="Bold"/>
                        <ComboBox
                            id="orderTypeFilter"
                            width="12rem"
                            placeholder="Select Order Type">
                            <core:Item key="MTS" text="MTS"/>
                            <core:Item key="MTO" text="MTO"/>
                        </ComboBox>
                    </VBox>

                    <Button
                        text="Search"
                        icon="sap-icon://search"
                        type="Emphasized"
                        press=".onGoFilter"/>
                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        class="sapUiTinyMarginBegin"
                        press=".onClearFilter"/>
                </HBox>
            </Panel>

            <!-- ================= TABLE ================= -->
            <VBox class="vpaCard vpaTableCard sapUiSmallMargin">

                <!-- title bar: outside the scroll container, so it does not scroll -->
                <OverflowToolbar>
                    <Title
                        text="{= 'Models (' + ${viewModel>/count} + ')' }"
                        level="H2"/>
                    <ToolbarSpacer/>
                    <Button
                        text="Add Row"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddRow"/>
                    <Button
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        press=".onRefresh"/>
                </OverflowToolbar>

                <ScrollContainer
                    width="100%"
                    horizontal="true"
                    vertical="false">

                    <Table
                        id="modelTable"
                        class="vpaTable"
                        items="{
                            path: '/Models',
                            parameters: { $$updateGroupId: 'modelGroup', $count: true },
                            sorter: { path: 'modelCode' }
                        }"
                        growing="true"
                        growingThreshold="20"
                        mode="MultiSelect"
                        updateFinished=".onTableUpdateFinished">

                        <columns>
                            <Column width="9rem"  hAlign="Begin"  vAlign="Middle"><Text text="Model Code"/></Column>
                            <Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Valid From"/></Column>
                            <Column width="14rem" hAlign="Begin"  vAlign="Middle"><Text text="Description"/></Column>
                            <Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Order Type"/></Column>
                            <Column width="10rem" hAlign="Begin"  vAlign="Middle"><Text text="Engine"/></Column>
                            <Column width="7rem"  hAlign="End"    vAlign="Middle"><Text text="CC / Watt"/></Column>
                            <Column width="7rem"  hAlign="End"    vAlign="Middle"><Text text="GST %"/></Column>
                            <Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="Dealer Margin %"/></Column>
                            <Column width="9rem"  hAlign="End"    vAlign="Middle"><Text text="CSD Discount %"/></Column>
                            <Column width="8rem"  hAlign="End"    vAlign="Middle"><Text text="CSD GST %"/></Column>
                            <Column width="8rem"  hAlign="End"    vAlign="Middle"><Text text="GeM Value"/></Column>
                            <Column width="10rem" hAlign="Center" vAlign="Middle"><Text text="Approval Status"/></Column>
                            <Column width="7rem"  hAlign="Center" vAlign="Middle"><Text text="Actions"/></Column>
                        </columns>

                        <!-- cells 1..10 are VBox [Text, editor]; the text shows in display mode,
                             the editor in edit mode (new rows are always in edit mode) -->
                        <items>
                            <ColumnListItem vAlign="Middle">
                                <cells>

                                    <!-- 0 MODEL CODE (key: editable only on new rows) -->
                                    <VBox>
                                        <Text
                                            text="{modelCode}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{modelCode}"
                                            placeholder="Model code"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 1 VALID FROM -->
                                    <VBox>
                                        <Text
                                            text="{validFrom}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <DatePicker
                                            value="{validFrom}"
                                            width="100%"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd-MM-yyyy"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 2 DESCRIPTION -->
                                    <VBox>
                                        <Text
                                            text="{modelDescription}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{modelDescription}"
                                            placeholder="Description"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 3 ORDER TYPE -->
                                    <VBox>
                                        <Text
                                            text="{orderType}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Select
                                            selectedKey="{orderType}"
                                            width="100%"
                                            visible="{= !!%{@$ui5.context.isTransient} }">
                                            <core:Item key="MTS" text="MTS"/>
                                            <core:Item key="MTO" text="MTO"/>
                                        </Select>
                                    </VBox>

                                    <!-- 4 ENGINE TYPE -->
                                    <VBox>
                                        <Text
                                            text="{engineType}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Select
                                            selectedKey="{engineType}"
                                            width="100%"
                                            visible="{= !!%{@$ui5.context.isTransient} }">
                                            <core:Item key="Petrol" text="Petrol"/>
                                            <core:Item key="EV" text="EV"/>
                                        </Select>
                                    </VBox>

                                    <!-- 5 CC / WATT -->
                                    <VBox>
                                        <Text
                                            width="100%"
                                            textAlign="End"
                                            text="{ccWatt}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{ccWatt}"
                                            type="Number"
                                            textAlign="End"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 6 GST % -->
                                    <VBox>
                                        <Text
                                            width="100%"
                                            textAlign="End"
                                            text="{gstPercent}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{gstPercent}"
                                            type="Number"
                                            textAlign="End"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 7 DEALER MARGIN % -->
                                    <VBox>
                                        <Text
                                            width="100%"
                                            textAlign="End"
                                            text="{dealerMarginPercent}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{dealerMarginPercent}"
                                            type="Number"
                                            textAlign="End"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 8 CSD DISCOUNT % -->
                                    <VBox>
                                        <Text
                                            width="100%"
                                            textAlign="End"
                                            text="{csdDiscountPercent}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{csdDiscountPercent}"
                                            type="Number"
                                            textAlign="End"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 9 CSD GST % -->
                                    <VBox>
                                        <Text
                                            width="100%"
                                            textAlign="End"
                                            text="{csdGstPercent}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{csdGstPercent}"
                                            type="Number"
                                            textAlign="End"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 10 GEM VALUE -->
                                    <VBox>
                                        <Text
                                            width="100%"
                                            textAlign="End"
                                            text="{gemValue}"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <Input
                                            value="{gemValue}"
                                            type="Number"
                                            textAlign="End"
                                            visible="{= !!%{@$ui5.context.isTransient} }"/>
                                    </VBox>

                                    <!-- 11 APPROVAL STATUS (set by the system) -->
                                    <ObjectStatus
                                        text="{approvalStatus}"
                                        state="{= ${approvalStatus} === 'DRAFT' ? 'Warning' : ${approvalStatus} === 'REJECTED' ? 'Error' : ${approvalStatus} === 'APPROVED' ? 'Success' : 'Information' }"/>

                                    <!-- 12 ACTIONS (edit only makes sense on saved rows) -->
                                    <HBox justifyContent="Center">
                                        <Button
                                            icon="sap-icon://edit"
                                            type="Transparent"
                                            tooltip="Edit"
                                            press=".onEdit"
                                            visible="{= !%{@$ui5.context.isTransient} }"/>
                                        <!-- <Button
                                            icon="sap-icon://delete"
                                            type="Transparent"
                                            tooltip="Delete"
                                            press=".onDelete"/> -->
                                    </HBox>

                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>

                </ScrollContainer>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    text="Cancel"
                    type="Transparent"
                    press=".onCancel"/>
                <Button
                    text="Submit"
                    type="Emphasized"
                    press=".onSubmit"/>
            </OverflowToolbar>
        </footer>

    </Page>

</mvc:View>