
<mvc:View
    controllerName="vpamasterdata.controller.MTOConfigurations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="mtoConfigurationsPage"
        class="vpaPage"
        backgroundDesign="Transparent"
        enableScrolling="true">

        <customHeader>
            <Bar class="vpaHeader">
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back"
                        press=".onNavBack"/>

                    <Title
                        text="MTO Configuration"
                        level="H1"/>
                </contentLeft>
            </Bar>
        </customHeader>

        <content>

            <!-- ================= FILTERS ================= -->

            <Panel
                class="vpaCard sapUiSmallMargin"
                headerText="Filters"
                expandable="true"
                expanded="true"
                backgroundDesign="Solid">

                <HBox
                    alignItems="End"
                    wrap="Wrap"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                    <!-- MTO MODEL FILTER -->
                    <VBox class="sapUiMediumMarginEnd">

                        <Label
                            text="MTO Model Code"
                            design="Bold"/>

                        <ComboBox
                            id="mtoModelCodeFilter"
                            width="16rem"
                            placeholder="Select MTO Model Code"
                            items="{modelsList>/configured}">

                            <core:Item
                                key="{modelsList>modelCode}"
                                text="{modelsList>modelCode}"/>

                        </ComboBox>

                    </VBox>

                    <!-- REFERENCE MTS FILTER -->
                    <VBox class="sapUiMediumMarginEnd">

                        <Label
                            text="Reference MTS Model"
                            design="Bold"/>

                        <ComboBox
                            id="mtoReferenceMTSFilter"
                            width="16rem"
                            placeholder="Select Reference MTS Model"
                            items="{modelsList>/mts}">

                            <core:Item
                                key="{modelsList>modelCode}"
                                text="{modelsList>modelCode}"/>

                        </ComboBox>

                    </VBox>

                    <!-- VALID FROM FILTER -->
                    <VBox class="sapUiMediumMarginEnd">

                        <Label
                            text="Valid From"
                            design="Bold"/>

                        <DatePicker
                            id="mtoValidFromFilter"
                            width="14rem"
                            placeholder="Select Valid From"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd-MMM-yyyy"/>

                    </VBox>

                    <Button
                        text="Search"
                        icon="sap-icon://search"
                        type="Emphasized"
                        press=".onFilter"/>

                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        class="sapUiTinyMarginBegin"
                        press=".onClearFilters"/>

                </HBox>

            </Panel>

            <!-- ================= MTO CONFIGURATIONS ================= -->

            <VBox class="vpaCard vpaTableCard sapUiSmallMargin">

                <!-- COMMON TOOLBAR -->

                <OverflowToolbar>

                    <Title
                        text="{= 'MTO Configurations (' + ${viewModel>/count} + ')' }"
                        level="H2"/>

                    <ToolbarSpacer/>

                    <Button
                        text="Add"
                        icon="sap-icon://add"
                        type="Emphasized"
                        enabled="{= !${viewModel>/isCreating} }"
                        press=".onAdd"/>

                    <Button
                        text="Refresh"
                        icon="sap-icon://refresh"
                        type="Transparent"
                        enabled="{= !${viewModel>/isCreating} }"
                        press=".onRefresh"/>

                    <!-- CANCEL TEMPORARY ROW -->
                    <Button
                        text="Cancel"
                        icon="sap-icon://decline"
                        type="Transparent"
                        visible="{viewModel>/isCreating}"
                        press=".onCancelCreate"/>

                </OverflowToolbar>

                <!-- ========================================== -->
                <!-- TEMPORARY EDITABLE ROW                      -->
                <!-- Displayed above existing records           -->
                <!-- ========================================== -->

                <Table
                    id="mtoCreateHeaderTable"
                    class="vpaTable"
                    visible="{viewModel>/isCreating}"
                    showSeparators="None"
                    items="{createHeader>/rows}">

                    <columns>

                        <Column>
                            <Text text="MTO Model Code"/>
                        </Column>

                        <Column>
                            <Text text="Valid From"/>
                        </Column>

                        <Column>
                            <Text text="Reference MTS Model"/>
                        </Column>

                        <Column width="10rem">
                            <Text text="Approval Status"/>
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            type="Navigation"
                            press=".onCreateConfigurationPress">

                            <cells>

                                <!-- MTO MODEL -->
                                <ComboBox
                                    width="100%"
                                    placeholder="Select MTO model"
                                    selectedKey="{createHeader>mtoModelCode}"
                                    showSecondaryValues="true"
                                    filterSecondaryValues="true"
                                    items="{
                                        path: 'modelsList>/mto',
                                        templateShareable: true
                                    }">

                                    <core:ListItem
                                        key="{modelsList>modelCode}"
                                        text="{modelsList>modelCode}"
                                        additionalText="{modelsList>modelDescription}"/>

                                </ComboBox>

                                <!-- VALID FROM -->
                                <DatePicker
                                    width="100%"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="dd-MMM-yyyy"
                                    value="{createHeader>validFrom}"/>

                                <!-- REFERENCE MTS -->
                                <ComboBox
                                    width="100%"
                                    placeholder="Select reference MTS model"
                                    selectedKey="{createHeader>referenceMTSModel_modelCode}"
                                    showSecondaryValues="true"
                                    filterSecondaryValues="true"
                                    items="{
                                        path: 'modelsList>/mts',
                                        templateShareable: true
                                    }">

                                    <core:ListItem
                                        key="{modelsList>modelCode}"
                                        text="{modelsList>modelCode}"
                                        additionalText="{modelsList>modelDescription}"/>

                                </ComboBox>

                                <!-- APPROVAL STATUS -->
                                <ObjectStatus
                                    text="{createHeader>approvalStatus}"
                                    state="None"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

                <!-- CREATE ROW INSTRUCTION -->
                <MessageStrip
                    text="Complete the configuration details and click the row navigation arrow to add parts."
                    type="Information"
                    showIcon="true"
                    visible="{viewModel>/isCreating}"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom"/>


                <!-- ========================================== -->
                <!-- EXISTING CONFIGURATIONS TABLE              -->
                <!-- ========================================== -->

                <Table
                    id="mtoConfigurationsTable"
                    class="vpaTable"
                    items="{
                        path: '/MTOConfigurations',
                        parameters: {
                            $count: true
                        },
                        sorter: {
                            path: 'mtoModelCode'
                        }
                    }"
                    growing="true"
                    growingThreshold="20"
                    sticky="ColumnHeaders"
                    updateFinished=".onTableUpdateFinished">

                    <columns>

                        <Column>
                            <Text text="MTO Model Code"/>
                        </Column>

                        <Column>
                            <Text text="Valid From"/>
                        </Column>

                        <Column>
                            <Text text="Reference MTS Model"/>
                        </Column>

                        <Column width="10rem">
                            <Text text="Approval Status"/>
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            type="Navigation"
                            press=".onConfigurationPress">

                            <cells>

                                <!-- MTO MODEL -->
                                <Text text="{mtoModelCode}"/>

                                <!-- VALID FROM -->
                                <Text text="{validFrom}"/>

                                <!-- REFERENCE MTS -->
                                <Text text="{referenceMTSModel_modelCode}"/>

                                <!-- APPROVAL STATUS -->
                                <ObjectStatus
                                    text="{approvalStatus}"
                                    state="{= ${approvalStatus} === 'APPROVED' ? 'Success' : ${approvalStatus} === 'SUBMITTED' ? 'Warning' : ${approvalStatus} === 'REJECTED' ? 'Error' : 'None'}"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>
