<mvc:View
    controllerName="vpamasterdata.controller.MTOConfigurations"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="mtoConfigurationsPage"
        class="vpaPage"
        backgroundDesign="Transparent"
        enableScrolling="true">

        <customHeader>
            <Bar class="vpaHeader">
                <contentLeft>
                    <Button
                        icon="sap-icon://nav-back"
                        type="Transparent"
                        tooltip="Back"
                        press=".onNavBack"/>
                    <Title text="MTO Configuration" level="H1"/>
                </contentLeft>
            </Bar>
        </customHeader>

        <content>

            <!-- ================= FILTERS ================= -->
            <Panel
                class="vpaCard sapUiSmallMargin"
                headerText="Filters"
                expandable="true"
                expanded="true"
                backgroundDesign="Solid">

                <HBox
                    alignItems="End"
                    wrap="Wrap"
                    class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">

                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="MTO Model Code" design="Bold"/>
                        <ComboBox
                            id="mtoModelCodeFilter"
                            width="16rem"
                            placeholder="Select MTO Model Code"
                            items="{modelsList>/configured}">
                            <core:Item
                                key="{modelsList>modelCode}"
                                text="{modelsList>modelCode}"/>
                        </ComboBox>
                    </VBox>

                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Reference MTS Model" design="Bold"/>
                        <ComboBox
                            id="mtoReferenceMTSFilter"
                            width="16rem"
                            placeholder="Select Reference MTS Model"
                            items="{modelsList>/mts}">
                            <core:Item
                                key="{modelsList>modelCode}"
                                text="{modelsList>modelCode}"/>
                        </ComboBox>
                    </VBox>

                    <VBox class="sapUiMediumMarginEnd">
                        <Label text="Valid From" design="Bold"/>
                        <DatePicker
                            id="mtoValidFromFilter"
                            width="14rem"
                            placeholder="Select Valid From"
                            valueFormat="yyyy-MM-dd"
                            displayFormat="dd-MMM-yyyy"/>
                    </VBox>

                    <Button
                        text="Search"
                        icon="sap-icon://search"
                        type="Emphasized"
                        press=".onFilter"/>
                    <Button
                        text="Clear"
                        icon="sap-icon://clear-filter"
                        class="sapUiTinyMarginBegin"
                        press=".onClearFilters"/>
                </HBox>
            </Panel>

            <!-- ================= TABLE ================= -->
            <VBox class="vpaCard vpaTableCard sapUiSmallMargin">

                <Table
                    id="mtoConfigurationsTable"
                    class="vpaTable"
                    items="{
                        path: '/MTOConfigurations',
                        parameters: { $$updateGroupId: 'mtoGroup', $count: true },
                        sorter: { path: 'mtoModelCode' }
                    }"
                    growing="true"
                    growingThreshold="20"
                    sticky="ColumnHeaders"
                    updateFinished=".onTableUpdateFinished">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title
                                text="{= 'MTO Configurations (' + ${viewModel>/count} + ')' }"
                                level="H2"/>
                            <ToolbarSpacer/>
                            <Button
                                text="Add"
                                icon="sap-icon://add"
                                type="Emphasized"
                                press=".onAdd"/>
                            <Button
                                text="Refresh"
                                icon="sap-icon://refresh"
                                type="Transparent"
                                press=".onRefresh"/>
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column><Text text="MTO Model Code"/></Column>
                        <Column><Text text="Valid From"/></Column>
                        <Column><Text text="Reference MTS Model"/></Column>
                        <Column width="10rem"><Text text="Approval Status"/></Column>
                        <Column width="6rem"><Text text="Actions"/></Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onConfigurationPress">
                            <cells>

                                <!-- [0] MTO model code: dropdown only on a new row -->
                                <VBox>
                                    <Text
                                        text="{mtoModelCode}"
                                        visible="{= !%{@$ui5.context.isTransient} }"/>
                                    <ComboBox
                                        width="100%"
                                        placeholder="Select MTO model"
                                        visible="{= !!%{@$ui5.context.isTransient} }"
                                        selectedKey="{mtoModelCode}"
                                        showSecondaryValues="true"
                                        filterSecondaryValues="true"
                                        items="{ path: 'modelsList>/mto', templateShareable: true }">
                                        <core:ListItem
                                            key="{modelsList>modelCode}"
                                            text="{modelsList>modelCode}"
                                            additionalText="{modelsList>modelDescription}"/>
                                    </ComboBox>
                                </VBox>

                                <!-- [1] Valid From: items = [Text, DatePicker] -->
                                <VBox>
                                    <Text
                                        text="{validFrom}"
                                        visible="{= !%{@$ui5.context.isTransient} }"/>
                                    <DatePicker
                                        width="100%"
                                        valueFormat="yyyy-MM-dd"
                                        displayFormat="dd-MMM-yyyy"
                                        value="{validFrom}"
                                        visible="{= !!%{@$ui5.context.isTransient} }"/>
                                </VBox>

                                <!-- [2] Reference MTS: items = [Text, ComboBox] -->
                                <VBox>
                                    <Text
                                        text="{referenceMTSModel_modelCode}"
                                        visible="{= !%{@$ui5.context.isTransient} }"/>
                                    <ComboBox
                                        width="100%"
                                        placeholder="Select reference MTS model"
                                        visible="{= !!%{@$ui5.context.isTransient} }"
                                        selectedKey="{referenceMTSModel_modelCode}"
                                        showSecondaryValues="true"
                                        filterSecondaryValues="true"
                                        items="{ path: 'modelsList>/mts', templateShareable: true }">
                                        <core:ListItem
                                            key="{modelsList>modelCode}"
                                            text="{modelsList>modelCode}"
                                            additionalText="{modelsList>modelDescription}"/>
                                    </ComboBox>
                                </VBox>

                                <!-- [3] Approval status (read-only) -->
                                <ObjectStatus
                                    text="{approvalStatus}"
                                    state="{= ${path: 'approvalStatus', targetType: 'any'} === 'APPROVED' ? 'Success'
                                            : ${path: 'approvalStatus', targetType: 'any'} === 'SUBMITTED' ? 'Warning'
                                            : 'None' }"/>

                                <!-- [4] Actions: items = [Edit, Delete] -->
                                <HBox>
                                    <Button
                                        icon="sap-icon://edit"
                                        type="Transparent"
                                        tooltip="Edit"
                                        press=".onEditRow"
                                        enabled="{= ${path: 'approvalStatus', targetType: 'any'} !== 'SUBMITTED' }"
                                        visible="{= !%{@$ui5.context.isTransient} }"/>
                                    <Button
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        tooltip="Delete"
                                        press=".onDelete"
                                        enabled="{= ${path: 'approvalStatus', targetType: 'any'} !== 'SUBMITTED' }"/>
                                </HBox>

                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>

            </VBox>
        </content>

        <!-- ================= FOOTER ================= -->
        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    text="Submit"
                    type="Emphasized"
                    icon="sap-icon://paper-plane"
                    press=".onSubmit"/>
                <Button
                    text="Cancel"
                    press=".onCancel"/>
            </OverflowToolbar>
        </footer>

    </Page>
</mvc:View>